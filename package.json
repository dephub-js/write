{
  "name": "@dephub/write",
  "type": "module",
  "version": "1.0.4",
  "description": "File writing utility with automatic directory creation for Node.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "write": "./dist/cli.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm check && pnpm test && pnpm build",
    "release": "pnpm publish",
    "docs": "lineo md 'src/**/*.ts' --outFile code.md --outDir temp",
    "test": "node --test",
    "check": "pnpm fmt && pnpm lint && pnpm check-types",
    "check-types": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --fix --max-warnings 0",
    "fmt": "prettier --write .",
    "clean": "rm -rf dist",
    "build": "vite build",
    "dev": "vite build -w --mode development"
  },
  "keywords": [
    "file",
    "write",
    "filesystem",
    "typescript",
    "node",
    "esm",
    "utility",
    "directory",
    "creation",
    "dephub"
  ],
  "author": {
    "name": "Estarlin R",
    "email": "dev@estarlincito.com",
    "url": "https://estarlincito.com"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://github.com/dephub-js/write#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dephub-js/write.git"
  },
  "bugs": {
    "url": "https://github.com/dephub-js/write/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dephub/command": "^3.0.0",
    "@dephub/logger": "^1.2.0"
  },
  "devDependencies": {
    "@dephub/eslint-ts": "^1.0.5",
    "@dephub/glob": "^1.0.2",
    "@dephub/path": "^2.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}